<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Reset Your Password</title>
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f4f6f8;
        color: #333;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 520px;
        background: #ffffff;
        margin: 50px auto;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #5e2b16, #f05b1b);
        color: #fff;
        text-align: center;
        padding: 25px 15px;
      }

      .header img {
        width: 50px;
        height: 28.5px;
        border-radius: 12px;
        margin-bottom: 8px;
      }

      .header h1 {
        margin: 0;
        font-size: 22px;
        letter-spacing: 0.5px;
      }
      .header {
        display: flex;

        justify-content: center;
        gap: 10px;
      }

      .content {
        padding: 30px;
        line-height: 1.6;
      }

      .content h2 {
        color: #111;
        font-size: 20px;
        margin-bottom: 10px;
      }

      .content p {
        font-size: 15px;
        color: #555;
      }

      .btn {
        display: inline-block;
        background: #F54A00;
        color: #ffffff !important;
        text-decoration: none;
        padding: 12px 24px;
        border-radius: 6px;
        margin-top: 20px;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .btn:hover {
        background: #cc5a29;
      }

      .footer {
        background: #f0f3f6;
        text-align: center;
        font-size: 13px;
        color: #777;
        padding: 15px;
      }

      .footer a {
        color: #007bff;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- <div class="header">
        <img src="https://i.ibb.co.com/v4537grn/logo.png" alt="VaultPay Logo" />
        <h1>VaultPay</h1>
      </div> -->
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background: linear-gradient(135deg, #5e2b16, #f05b1b); padding: 20px 0; text-align: center;">
        <tr>
          <td align="center">
            <table cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" style="padding-right: 10px;">
                  <img src="https://i.ibb.co.com/v4537grn/logo.png" alt="VaultPay Logo" width="50" height="28.5" style="display: block; border-radius: 12px;">
                </td>
                <td align="center">
                  <h1 style="margin: 0; font-size: 22px; color: #ffffff; font-family: Segoe UI, Arial, sans-serif;">
                    VaultPay
                  </h1>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      
      <div class="content">
        <h2>Password Reset Request</h2>
        <p>Hello <%= name %>,</p>
        <p>We received a request to reset your VaultPay account password. Click the button below to set a new password:</p>
        <p style="text-align: center">
          <a class="btn" href="<%= resetUILink %>" target="_blank">Reset Password</a>
        </p>
        <p>This link will expire in <strong>5 minutes</strong>. If you didn’t request this, you can safely ignore this email.</p>
      </div>

      <div class="footer">&copy; <%= new Date().getFullYear() %> VaultPay. All rights reserved.</div>
    </div>
  </body>
</html>
